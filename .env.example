# Storage provider: local (JSON files) or azure_blob
STORAGE_PROVIDER=local
DATA_DIR=data

# Azure Blob Storage (only when STORAGE_PROVIDER=azure_blob)
# Preferred: managed identity / DefaultAzureCredential
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# Alternative: connection string (keep out of source control)
# AZURE_STORAGE_CONNECTION_STRING=<connection-string>
AZURE_STORAGE_CONTAINER=matches

# Password required to delete a match (default: miltonkeynes600028)
# DELETE_PASSWORD=change-me
